{
  "expo": {
    "scheme": "circle-u-mobile-app",
    "name": "circle-u-mobile-app",
    "slug": "circle-u-mobile-app",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/img/logo.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4ea35e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons"
    ]
  }
}
